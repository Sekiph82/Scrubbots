    "attempt": [[2, "1"], [3, "2"], [4, "3"], [6, "4_5"], [11, "6_10"], [-1, "gt_10"]],
    "count": [[1, "0"], [2, "1"], [3, "2"], [6, "3_5"], [-1, "gt_5"]],
