; Engine configuration file.
; SCRUBBOTS Level Factory — separate nested Godot project.
config_version=5

[application]

config/name="SCRUBBOTS Level Factory"
config/description="Offline deterministic level generation, solver, difficulty analysis, human review and QA sidecar."

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
